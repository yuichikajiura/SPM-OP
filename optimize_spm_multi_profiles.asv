
%% Configuration
cell_target = 2 ;% target cell to identify params. 1:fresh, 2:degraded
cell_known = 1; % cell of known parameter. 1:fresh, 2:degraded
bound = 1.5; %ratio to the known params of other cell for the boundary of param search range
profiles = ["UDDSx2", "FUDS", "BJDST", "Charge", "Charge2"]; %option:UDDSx2, FUDS, BJDST, Charge, Charge2, US06_Extended
tell_csp0 = false; % true if assume we know initial concentration 
p_targets = [1, 3, 4, 5, 6]; %%1:nLi, 2:R_f_n, 3:k_n, 4:k_p, 5:D_s_n, 6:D_s_p (0 to estimate csp0)
Nr_model = 20;
Nr_data = 100;
methods = 2; %1:GA, 2:PSO

    
%% Parameters

%%% setting parameters
if cell_known == 1
    run params_setting % load params

else
    run params_setting_2
end

p_upper = [p.n_Li_s; p.R_f_n; p.k_n; p.k_p; p.D_s_n; p.D_s_p].* bound;
p_lower = [p.n_Li_s; p.R_f_n; p.k_n; p.k_p; p.D_s_n; p.D_s_p]./ bound;

if cell_target == 1
    run params_setting
else
    run params_setting_2
end

p_true = [p.n_Li_s; p.R_f_n; p.k_n; p.k_p; p.D_s_n; p.D_s_p];

for i = 1:6
    if ~ismember(i, p_targets)
        p_upper(i) = p_true(i);
        p_lower(i) = p_true(i);
    end
    p_upper(i) = p_upper(i)/p_true(i);
    p_lower(i) = p_lower(i)/p_true(i);
end

%%% Finite Difference Model for particle
p.Nr = Nr_model;
p.delta_r_n = 1/p.Nr;
p.delta_r_p = 1/p.Nr;
r_vec = (0:p.delta_r_n:1)';
r_vecx = r_vec(2:end-1);

%%% Finite Difference points along x-coordinate
p.Nxn = 10;
p.Nxs = 5;
p.Nxp = 10;
p.Nx = p.Nxn + p.Nxs + p.Nxp;
Nx = p.Nx - 3;

p.delta_x_n = 1 / p.Nxn;
p.delta_x_s = 1 / p.Nxs;
p.delta_x_p = 1 / p.Nxp;

%%% white noise setup
noise = 0.03;  % the magnitude of white noise to standard deviation of data
std_current = 38;  % standard deviation of current data in Ampere
std_voltage = 0.16;  % standard deviation of voltage data in Volt

%%% data setup
data = readtable("data/SPM_FDM_nr"+Nr_data+"_simulation_"+profiles(1)+"_cell"+cell_target+".csv");
data.Properties.VariableNames = {'t', 'I', 'V_spm', 'css_n', ...
    'cs_ave_n', 'css_p', 'cs_ave_p'};
I = data.I;
v_true = data.V_spm;
I1 = I + normrnd(0, std_current * noise, size(I));
v1_true = v_true + normrnd(0, std_voltage * noise, size(v_true));
t1 = data.t;
csp0_1_true = data.cs_ave_p(1);

data = readtable("data/SPM_FDM_nr"+Nr_data+"_simulation_"+profiles(2)+"_cell"+cell_target+".csv");
data.Properties.VariableNames = {'t', 'I', 'V_spm', 'css_n', ...
    'cs_ave_n', 'css_p', 'cs_ave_p'};
I = data.I;
v_true = data.V_spm;
I2 = I + normrnd(0, std_current * noise, size(I));
v2_true = v_true + normrnd(0, std_voltage * noise, size(v_true));
t2 = data.t;
csp0_2_true = data.cs_ave_p(1);

data = readtable("data/SPM_FDM_nr"+Nr_data+"_simulation_"+profiles(3)+"_cell"+cell_target+".csv");
data.Properties.VariableNames = {'t', 'I', 'V_spm', 'css_n', ...
    'cs_ave_n', 'css_p', 'cs_ave_p'};
I = data.I;
v_true = data.V_spm;
I3 = I + normrnd(0, std_current * noise, size(I));
v3_true = v_true + normrnd(0, std_voltage * noise, size(v_true));
t3 = data.t;
csp0_3_true = data.cs_ave_p(1);

data = readtable("data/SPM_FDM_nr"+Nr_data+"_simulation_"+profiles(3)+"_cell"+cell_target+".csv");
data.Properties.VariableNames = {'t', 'I', 'V_spm', 'css_n', ...
    'cs_ave_n', 'css_p', 'cs_ave_p'};
I = data.I;
v_true = data.V_spm;
I4 = I + normrnd(0, std_current * noise, size(I));
v4_true = v_true + normrnd(0, std_voltage * noise, size(v_true));
t4 = data.t;
csp0_4_true = data.cs_ave_p(1);

% Area for param search
p_true = [p_true; csp0_1_true; csp0_2_true; csp0_3_true; csp0_4_true; csp0_5_true];

csp_lower = 0;
csp_1_upper = p.c_s_p_max / csp0_1_true;
csp_2_upper = p.c_s_p_max / csp0_2_true;
csp_3_upper = p.c_s_p_max / csp0_3_true;
csp_4_upper = p.c_s_p_max / csp0_4_true;
csp_5_upper = p.c_s_p_max / csp0_5_true;

if tell_csp0
    lb = [p_lower; 1; 1; 1; 1; 1];
    ub = [p_upper; 1; 1; 1; 1; 1];
else        
    lb = [p_lower; csp_lower; csp_lower; csp_lower; csp_lower; csp_lower];
    ub = [p_upper; csp_1_upper; csp_2_upper; csp_3_upper; csp_4_upper; csp_5_upper];
end

v_true = [v1_true; v2_true; v3_true; v4_true; v5_true];

params = @(x, i) param_update(p, p_true, x, i);
c_n0 = @(x, i) init_cs_paramID(params(x, i), 2);  %x = [p_targets; c_p0_x]
c_p0 = @(x, i) init_cs_paramID(params(x, i), 1);  %x = [p_targets; c_p0_x]
c_n0_Nr = @(x, i) c_n0(x, i) * ones(p.Nr-1,1);
c_p0_Nr = @(x, i) c_p0(x, i) * ones(p.Nr-1,1);
sys_n = @(x, i) spm_plant_obs_mats_paramID_n(params(x, i));
sys_p = @(x, i) spm_plant_obs_mats_paramID_p(params(x, i));
css_n = @(x, I, t, i) calc_css(sys_n(x, i), I, t, c_n0_Nr(x, i));
css_p = @(x, I, t, i) calc_css(sys_p(x, i), I, t, c_p0_Nr(x, i));
v_pred = @(x, I, t, i) nonlinearSPMOutputVoltage_paramID(params(x, i),css_n(x, I, t, i),css_p(x, I, t, i),p.c_e,p.c_e,p.c_e,I);
objFun = @(x) my_rmse([v_pred(x, I1, t1, 1); v_pred(x, I2, t2, 2); ...
    v_pred(x, I3, t3, 3); v_pred(x, I4, t4, 4); v_pred(x, I5, t5, 5)],...
    v_true);

if method==1
    pop_size = (numel(p_targets)+1)*20;
    max_gen = (numel(p_targets)+1)*100;
    options = optimoptions("ga","Display","iter", ...
        "FunctionTolerance",1e-3, ...
        'PlotFcn','gaplotbestindiv', ...
        'UseParallel', true, ...
        'UseVectorized', false, ...
        'PopulationSize', pop_size, ...
        'MaxGenerations', max_gen);
    x_est = ga(objFun,7,[],[],[],[],lb,ub, [], options);
else
    options = optimoptions("particleswarm","Display","iter", ...
        'UseParallel', true, ...
        'UseVectorized', false, ...
        "FunctionTolerance",1e-3);
    x_est = particleswarm(objFun,7,lb,ub,options);
end
disp(x_est);

% Function used in optimization algorithm 
function css = calc_css(sys, I, t, c_0)
    [csz, t, c_x] = lsim(sys, I, t, c_0);
    css = csz(:,2);
end

function params = param_update(params, params_true, x, i)
    params.n_Li_s = x(1) * params_true(1);
    params.R_f_n = x(2) * params_true(2);
    params.k_n = x(3) * params_true(3);
    params.k_p = x(4) * params_true(4);
    params.D_s_n = x(5) * params_true(5);
    params.D_s_p = x(6) * params_true(6);
    params.csp0 = x(6+i) * params_true(6+i);
end

function rmse = my_rmse(actual, predicted)
    rmse = sqrt(mean((actual - predicted).^2));
end

function stop = pso_outfun(optimValues, ~)
    stop = false;
    disp([' x = ',num2str(optimValues.bestx)]); 
end